# ============================================================================
# Frontend Environment Variables (Safe to expose to browser via Vite)
# Copy this file to `.env.local` for local development, and add these keys
# in Vercel -> Project Settings -> Environment Variables.
# NEVER put SUPABASE_SERVICE_ROLE_KEY, sb_secret_*, or OPENAI_API_KEY here.
# ============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ============================================================================
# Server-Side Secrets (Configure ONLY in Supabase Edge Function Secrets)
# Run: supabase secrets set OPENAI_API_KEY=... ALLOWED_ORIGIN=...
# ============================================================================
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_ASSISTANT_MODEL=gpt-4o-mini
# ALLOWED_ORIGIN=https://your-vercel-domain.vercel.app
# RATE_LIMIT_SALT=replace-with-random-string
